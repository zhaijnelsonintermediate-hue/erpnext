# 复制为 docker/.env 后按需修改：cp docker/.env.example docker/.env

# ---- 镜像 ----
# 由 docker/build-image.sh 构建出来的自定义镜像（同时包含 erpnext + crm）。
# 官方 frappe/erpnext 镜像里没有 crm 应用，所以这里必须用自建镜像。
IMAGE=erpnext-crm:local

# 构建自定义镜像时使用的 frappe 框架分支。要跟 docker/apps.json 里的分支保持同一大版本。
FRAPPE_BRANCH=version-16

# 构建上下文用的 frappe_docker 版本（分支或 tag）
FRAPPE_DOCKER_REF=main

# ---- 站点 ----
# 站点名同时用作 nginx 的 FRAPPE_SITE_NAME_HEADER，单站点部署下二者必须一致。
SITE_NAME=erp.localhost

# 首次创建站点时使用；请在正式环境中改掉。
ADMIN_PASSWORD=admin
DB_PASSWORD=admin

# ---- 网络 ----
# 宿主机上暴露的 HTTP 端口
HTTP_PUBLISH_PORT=8080

# ---- 依赖镜像版本 ----
MARIADB_VERSION=11.8
REDIS_VERSION=6.2-alpine
